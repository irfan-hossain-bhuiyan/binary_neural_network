{
  "description": "Recovered discretizing baseline — TRAINING procedure from train_xor.py@065f64d adapted to current OR architecture. Architecture unchanged. See research/recovered_training_regime.md for provenance.",
  "provenance": {
    "source_commit": "065f64d",
    "source_file": "train_xor.py",
    "architecture_note": "Current OR gate (layers.py/discrete_logic_net.py) matches historical OR; no NOR/restoration needed",
    "indexing_note": "even_init applies to i%2==0 (layer 0,2…), odd_init to i%2==1 (layer 1,3…)"
  },
  "discretization_threshold": 0.5,
  "task": {
    "task": "bitwise_xor",
    "params": {
      "bits": 16,
      "num_samples": 100000,
      "train_ratio": 0.8
    }
  },
  "model": {
    "hidden_dims": [64, 32],
    "init_temperature": 1.0,
    "shared_temperature": true,
    "learnable_tau": true,
    "use_softmax": true,
    "grad_scalar": true,
    "even_init": {"type": "normal", "mean": 1.0},
    "odd_init": {"type": "normal", "mean": 0.0},
    "bias_init": {"type": "normal", "mean": 1.0}
  },
  "training": {
    "epochs": 300,
    "batch_size": 256,
    "optimizer": "Adam",
    "lr": 0.01,
    "loss": "MSELoss",
    "regularizer": {
      "type": "regularization_factory2",
      "disc_lambda": 0.5,
      "tau_lambda": 0.3,
      "patience": 15,
      "min_err": 0.01,
      "isolate_on_plateau": true
    },
    "constraints": [
      "clamp_weights_bias_temperature",
      {
        "type": "noise_on_plateau",
        "std": 0.3,
        "patience": 15,
        "min_delta": 0.01
      }
    ],
    "variance_weight": null,
    "start_temperature": null,
    "end_temperature": null
  }
}
